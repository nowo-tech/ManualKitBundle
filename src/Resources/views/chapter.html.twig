{% extends nowo_manual_layout() %}
{% trans_default_domain 'NowoManualKitBundle' %}

{#
 # A chapter page. Variables: rendered (RenderedManualChapter: chapter, html, toc), chapters (the chapters the viewer
 # may read, in the locale, each followed by its sub-pages), previous, next, ancestors (1.6: the chapters above this
 # one, top-level first), children (1.6: its sub-pages the viewer may read) and groups (1.8: the navigation groups,
 # [{key, label, translation_domain}] in the `groups` order; label null = group.<key> of this bundle). Override it in
 # templates/bundles/NowoManualKitBundle/chapter.html.twig, or set `nowo_manual_kit.template` to one of the
 # application's templates. Link chapters with manual_chapter_path(chapter): it knows their place in the tree.
 #
 # 1.8 blocks, so a host template can extend this one instead of copying it: manual_nav (the chapter list, with
 # manual_nav_start before the groups), manual_body (the chapter article, with manual_body_start at its top) and
 # manual_aside (after the article, empty). The macros live in @NowoManualKitBundle/_macros.html.twig (branch, children):
 # a host template imports them itself.
 #}
{% set chapter = rendered.chapter %}
{% import '@NowoManualKitBundle/_macros.html.twig' as nav %}

{% block title %}{{ chapter.isHome ? 'title'|trans : chapter.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/manual.css', 'nowo_manual_kit') }}">
{% endblock %}

{% block body %}
{% if groups is not defined %}
{% set groups = [] %}
{% for item in chapters %}{% if item.group not in groups|column('key') %}{% set groups = groups|merge([{key: item.group, label: null, translation_domain: 'messages'}]) %}{% endif %}{% endfor %}
{% endif %}
<div class="nowo-manual" data-testid="manual">
    {% block manual_nav -%}
    <nav class="nowo-manual__nav" aria-label="{{ 'chapters'|trans }}" data-testid="manual-nav">
{% block manual_nav_start %}{% endblock %}
        {% for group in groups %}
            <p class="nowo-manual__group">{{ group.label is null ? ('group.' ~ group.key)|trans : group.label|trans({}, group.translation_domain) }}</p>
            <ul class="nowo-manual__list">
                {% for item in chapters|filter(c => c.group == group.key and c.ancestors is empty) %}
                    <li>
                        <a href="{{ manual_chapter_path(item) }}"{% if item.slug == chapter.slug %} aria-current="page"{% endif %} data-testid="manual-nav-{{ item.slug }}">{{ item.isHome ? 'home'|trans : item.title }}</a>{{ chapters|filter(c => c.parent == item.slug) is not empty ? nav.branch(item, chapters, chapter) }}
                    </li>
                {% endfor %}
            </ul>
        {% endfor %}
    </nav>
{% endblock %}

    {% block manual_body -%}
    <article class="nowo-manual__chapter" data-testid="manual-chapter" data-chapter="{{ chapter.slug }}" data-controller="nowo-manual-lightbox" data-nowo-manual-lightbox-zoom-label-value="{{ 'zoom'|trans|e('html_attr') }}" data-action="click->nowo-manual-lightbox#zoom">
{% block manual_body_start %}{% endblock %}
        {% if chapter.translation.value in ['missing', 'outdated'] %}
            <p class="nowo-manual__notice nowo-manual__notice--{{ chapter.translation.value }}" role="note" data-testid="manual-translation-notice">{{ ('notice.' ~ chapter.translation.value)|trans }}</p>
        {% endif %}
        {%- if ancestors is not empty %}
        {% set crumbs = [{label: 'title'|trans, href: path('nowo_manual_index')}] %}
        {% for ancestor in ancestors %}{% set crumbs = crumbs|merge([{label: ancestor.title, href: manual_chapter_path(ancestor)}]) %}{% endfor %}
        <div class="nowo-manual__breadcrumbs" data-testid="manual-breadcrumbs">{{ include(nowo_manual_breadcrumbs_template(), {header: {breadcrumbs: crumbs|merge([{label: chapter.title, href: null}]), breadcrumbsMode: 'own', breadcrumbCollection: null}, bundle: 'NowoManualKitBundle'}) }}</div>
        {%- endif %}
        <h1>{{ chapter.title }}</h1>
        {% if rendered.toc is not empty %}
            <nav class="nowo-manual__toc" aria-label="{{ 'on_this_page'|trans }}" data-testid="manual-toc">
                <p class="nowo-manual__group">{{ 'on_this_page'|trans }}</p>
                <ul>
                    {% for entry in rendered.toc|filter(e => e.level < 4) %}
                        <li class="nowo-manual__toc-item--{{ entry.level }}"><a href="#{{ entry.id }}">{{ entry.text }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
        <div class="manual-prose">{{ rendered.html|raw }}</div>{{ children is not empty ? nav.children(children) }}
        <dialog class="manual-lightbox" aria-label="{{ 'zoom'|trans }}" data-nowo-manual-lightbox-target="dialog" data-action="click->nowo-manual-lightbox#backdrop keydown->nowo-manual-lightbox#keydown" data-testid="manual-lightbox">
            <figure class="manual-lightbox__figure">
                <img class="manual-lightbox__image" alt="" data-nowo-manual-lightbox-target="image">
                <figcaption class="manual-lightbox__caption" data-nowo-manual-lightbox-target="caption" hidden></figcaption>
            </figure>
            <button type="button" class="manual-lightbox__nav manual-lightbox__nav--previous" data-nowo-manual-lightbox-target="previous" data-action="nowo-manual-lightbox#previous" aria-label="{{ 'lightbox.previous'|trans }}">‹</button>
            <button type="button" class="manual-lightbox__nav manual-lightbox__nav--next" data-nowo-manual-lightbox-target="next" data-action="nowo-manual-lightbox#next" aria-label="{{ 'lightbox.next'|trans }}">›</button>
            <button type="button" class="manual-lightbox__close" data-action="nowo-manual-lightbox#close" aria-label="{{ 'lightbox.close'|trans }}" data-testid="manual-lightbox-close">×</button>
        </dialog>
        <nav class="nowo-manual__pager" aria-label="{{ 'pager'|trans }}">
            {% if previous %}
                <a href="{{ manual_chapter_path(previous) }}" rel="prev" data-testid="manual-previous">← {{ previous.isHome ? 'home'|trans : previous.title }}</a>
            {% else %}<span></span>{% endif %}
            {% if next %}
                <a href="{{ manual_chapter_path(next) }}" rel="next" data-testid="manual-next">{{ next.title }} →</a>
            {% endif %}
        </nav>
    </article>
{% endblock %}
{% block manual_aside %}{% endblock %}
</div>
{% if nowo_manual_standalone_lightbox() %}
    <script src="{{ asset('js/manual-lightbox.js', 'nowo_manual_kit') }}" defer></script>
{% endif %}
{% endblock %}
