{
  "name": "manual-kit-bundle-assets",
  "version": "1.0.0",
  "description": "Frontend of nowo-tech/manual-kit-bundle (private, not published to npm): the Stimulus lightbox peer the application bundles, and its self-contained Vite build in src/Resources/public/js.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/Resources/assets",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hotwired/stimulus": "^3.2.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
