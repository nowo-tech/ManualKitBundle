{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.heading'|trans, intro: 'demo.lead'|trans}) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card" data-screenshot-target>
        <div class="nowo-ui-card__body">
            <h2 class="nowo-ui-card__title">{{ 'demo.features.title'|trans }}</h2>
            <ul>
                {% for key in ['source', 'locales', 'anchors', 'audience', 'tree', 'search', 'figures', 'check', 'theming'] %}
                    <li>{{ ('demo.features.' ~ key)|trans }}</li>
                {% endfor %}
            </ul>
        </div>
    </section>
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <h2 class="nowo-ui-card__title">{{ 'demo.try.title'|trans }}</h2>
            {% if app.user %}
                <p>{{ 'demo.try.signed_in'|trans }}</p>
                <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_manual_index', {_locale: app.request.locale}) }}" data-testid="open-manual">{{ 'demo.try.open'|trans }}</a>
                <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ manual_href('manual/01-getting-started.md#first-steps') }}">{{ 'demo.try.anchor'|trans }}</a>
            {% else %}
                <p>{{ 'demo.try.guest'|trans }}</p>
                <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('demo_login', { _locale: app.request.locale }) }}">{{ 'demo.login.nav'|trans }}</a>
            {% endif %}
        </div>
    </section>
{% endblock %}
