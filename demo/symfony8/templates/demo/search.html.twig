{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.search.title'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.search.title'|trans}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.search.nav'|trans, kind: 'form', search_form: search_form} %}
        {% block section_body %}
            <div role="search">{{ include('demo/_form.html.twig', { form: search_form }) }}</div>
        {% endblock %}
    {% endembed %}
    {% if q is not empty %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.search.title'|trans, kind: 'list', empty: items is empty, state_message: 'demo.search.empty'|trans, testid: items is empty ? 'manual-search-empty' : null, items: items} %}
            {% block section_body %}
                <ul class="nowo-ui-list" data-testid="manual-search-results">
                    {% for item in items %}
                        <li class="nowo-ui-list-item">
                            <a class="nowo-ui-link" href="{{ item.url }}" data-testid="manual-search-result">{{ item.title }}</a>
                            <div class="nowo-ui-muted">{{ item.subtitle }}</div>
                        </li>
                    {% endfor %}
                </ul>
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
