{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.search.title'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.search.title'|trans}) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card" role="search">
        <div class="nowo-ui-card__body">{{ include('demo/_form.html.twig', { form: search_form }) }}</div>
    </section>
    {% if q is not empty %}
        {% if items is empty %}
            <p data-testid="manual-search-empty">{{ 'demo.search.empty'|trans }}</p>
        {% else %}
            <ul class="nowo-ui-list" data-testid="manual-search-results">
                {% for item in items %}
                    <li class="nowo-ui-list-item">
                        <a class="nowo-ui-link" href="{{ item.url }}" data-testid="manual-search-result">{{ item.title }}</a>
                        <div class="nowo-ui-muted">{{ item.subtitle }}</div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}
{% endblock %}
