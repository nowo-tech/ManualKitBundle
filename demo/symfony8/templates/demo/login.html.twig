{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.login.nav'|trans, intro: 'demo.login.hint'|trans}) }}
{% endblock %}

{% block body %}
    {% if login_error %}
        <div class="nowo-ui-flash nowo-ui-flash--error" role="alert">{{ login_error.messageKey|trans(login_error.messageData, 'security') }}</div>
    {% endif %}
    {% if app.user %}
        <div class="nowo-ui-flash nowo-ui-flash--success" role="status">{{ 'demo.login.signed_in'|trans({ '%user%': app.user.userIdentifier }) }}</div>
    {% endif %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            {{ include('demo/_form.html.twig', { form: login_form }) }}
        </div>
    </section>
{% endblock %}
