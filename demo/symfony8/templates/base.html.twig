{#
  REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig).
  This file only declares the demo (nowo_ui_demo_platform). It is also the manual's layout (nowo_manual_kit.layout):
  the bundle's chapter template fills the `title`, `stylesheets` and `body` blocks. Vite only builds the manual's
  lightbox peer (no stylesheet).
#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _locale = app.request.locale %}
{% set nowo_ui_demo_platform = {
    bundle: 'Manual Kit',
    home_route: 'homepage',
    home_params: {_locale: _locale},
    repository: 'https://github.com/nowo-tech/ManualKitBundle',
    translation_domain: 'messages',
    locales: ['en', 'es'],
    auth: {login_route: 'demo_login', logout_route: 'demo_logout'},
    nav: app.user
        ? [
            {label: 'demo.nav.home', route: 'homepage', params: {_locale: _locale}, section: 'demo.nav.demo'},
            {label: 'demo.manual', route: 'nowo_manual_index', params: {_locale: _locale}, active: ['nowo_manual_*'], section: 'demo.nav.manual', testid: 'nav-manual'},
            {label: 'demo.search.nav', route: 'demo_manual_search', params: {_locale: _locale}, section: 'demo.nav.manual', testid: 'nav-search'},
        ]
        : [
            {label: 'demo.nav.home', route: 'homepage', params: {_locale: _locale}, section: 'demo.nav.demo'},
            {label: 'demo.manual', route: 'nowo_manual_index', params: {_locale: _locale}, active: ['nowo_manual_*'], section: 'demo.nav.manual', testid: 'nav-manual'},
        ],
} %}
{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans }}{% endblock %}{% endblock %}

{% block nowo_ui_head %}
    {{ vite_entry_link_tags('app') }}
    {% block stylesheets %}{% endblock %}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('app') }}
    {% block javascripts %}{% endblock %}
{% endblock %}
