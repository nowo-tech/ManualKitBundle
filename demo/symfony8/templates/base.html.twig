{#
  Demo host layout. It is also the manual's layout (nowo_manual_kit.layout): the bundle's chapter template fills the
  `title`, `stylesheets` and `body` blocks. Bootstrap and Vite are loaded by the demo, never by the bundle.
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'demo.title'|trans }}{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('demo.css') }}">
        {{ vite_entry_link_tags('app') }}
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        {% set locale_route = app.request.attributes.get('_route') %}
        {% set locale_params = app.request.attributes.get('_route_params')|default({}) %}
        <nav class="navbar navbar-expand-lg navbar-dark demo-navbar">
            <div class="container">
                <a class="navbar-brand" href="{{ path('homepage', { _locale: app.request.locale }) }}">{{ 'demo.brand'|trans }}</a>
                <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <a class="nav-link text-white" href="{{ path('nowo_manual_index', { _locale: app.request.locale }) }}" data-testid="nav-manual">{{ 'demo.manual'|trans }}</a>
                    {% if app.user %}
                        <span class="navbar-text text-white-50 small">{{ app.user.userIdentifier }}</span>
                        <a class="nav-link text-white" href="{{ path('demo_logout') }}">{{ 'demo.logout'|trans }}</a>
                    {% else %}
                        <a class="nav-link text-white" href="{{ path('demo_login', { _locale: app.request.locale }) }}">{{ 'demo.login.nav'|trans }}</a>
                    {% endif %}
                    {% if locale_route %}
                        <div class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="localeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{ 'demo.language'|trans }} ({{ app.request.locale|upper }})
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="localeDropdown">
                                <li><a class="dropdown-item {{ app.request.locale == 'en' ? 'active' : '' }}" href="{{ path(locale_route, locale_params|merge({ _locale: 'en' })) }}">English</a></li>
                                <li><a class="dropdown-item {{ app.request.locale == 'es' ? 'active' : '' }}" href="{{ path(locale_route, locale_params|merge({ _locale: 'es' })) }}">Español</a></li>
                            </ul>
                        </div>
                    {% endif %}
                </div>
            </div>
        </nav>
        <main>{% block body %}{% endblock %}</main>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {{ vite_entry_script_tags('app') }}
        {% block javascripts %}{% endblock %}
    </body>
</html>
